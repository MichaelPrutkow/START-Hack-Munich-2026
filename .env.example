# Copy to .env and fill in. .env is gitignored. Never commit or paste keys.
TEAM_API_KEY=
# OpenAI keys, tried in order. A key that returns 401 or insufficient_quota is
# disabled for the rest of the tournament, a rate-limited one for the current round.
OPENAI_KEY_1=
OPENAI_KEY_2=
OPENAI_KEY_3=
# Optional. Three pipelines run in parallel, the last one done before the deadline wins:
# rules (instant) -> fast (small model, several votes) -> deep (best model, high reasoning).
# `uv run runner.py --check` lists the models your key can use. DEEP_MODEL=off disables deep.
FAST_MODEL=gpt-5.6-terra
FAST_REASONING=none
FAST_VOTES=3
DEEP_MODEL=gpt-6.2-astra
DEEP_REASONING=high
DEEP_VOTES=3
# Pricing (claim_to_fame/pricing.py; runner.py reads these settings). a = A_MULT * estimate; b from P(fair) > 2/3 with log-spread SIGMA.
# Change only with evidence from `uv run calibrate.py --team chineseModels` and log it in notes/DECISIONS.md.
A_MULT=0.85
SIGMA=0.35
# Disagreement flag only: a high ratio never raises the median estimate.
DISAGREE=1.5

# Focused recheck after a complete deep submission, only within remaining deadline.
FOCUS_ENABLED=1
FOCUS_MAX_LINES=2
FOCUS_BUDGET=12
# Experimental spread-based price adjustment: evaluate before enabling.
PRICING_UNCERTAINTY=0
# Optional absolute learning artifact path; default is out/learning.json beside runner.py.
# LEARNING_FILE=/absolute/path/to/out/learning.json
