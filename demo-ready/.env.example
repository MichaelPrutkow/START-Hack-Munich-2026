# Copy to .env and fill in. .env is gitignored. Never commit or paste keys.
TEAM_API_KEY=YOUR_API_KEY_HERE
# OpenAI keys, tried in order. A key that returns 401 or insufficient_quota is
# disabled for the rest of the tournament, a rate-limited one for the current round.
OPENAI_KEY_1=YOUR_API_KEY_HERE
OPENAI_KEY_2=YOUR_API_KEY_HERE
OPENAI_KEY_3=YOUR_API_KEY_HERE
# Optional. Three pipelines run in parallel, the last one done before the deadline wins:
# rules (instant) -> fast (small model, several votes) -> deep (best model, high reasoning).
# `uv run runner.py --check` lists the models your key can use. DEEP_MODEL=off disables deep.
FAST_MODEL=gpt-5.6-terra
FAST_REASONING=none
FAST_VOTES=3
DEEP_MODEL=gpt-6.2-astra
DEEP_REASONING=high
DEEP_VOTES=3
# Latency-first trial: DEEP_REASONING=medium and DEEP_VOTES=1. Restart between games.
# Pricing (claim_to_fame/pricing.py; runner.py reads these settings). a = A_MULT * estimate; b from P(fair) > 2/3 with log-spread SIGMA.
# Live values since 21.11. 19:15: A_MULT 0.75 with prompt hints v3 (LLM backtest), SIGMA 1.0 (b ~ 0.65 m, just below a), AUTO_TUNE=0.
# Validated per-tier learning may override eligible lines only with AUTO_TUNE=1; inspect with `uv run learn.py --status`.
A_MULT=0.75
SIGMA=1.0
# Re-read before every game (no restart needed). AUTO_TUNE=1 applies matching validated
# parameters from learning.json per line; AUTO_TUNE=0 pins the defaults above.
# Exploratory params.json proposals are never loaded into the runner.
AUTO_TUNE=0
# Disagreement flag only: a high ratio never raises the median estimate.
DISAGREE=1.5

# Focused recheck after a complete deep submission, only within remaining deadline.
FOCUS_ENABLED=1
FOCUS_MAX_LINES=2
FOCUS_BUDGET=12
# Independent control: up to two lines, one extra assessment after all production workers finish.
# No historical price context or prior estimates; never submits. Skipped with <4s usable time.
# Maximum assessment budget 8s, leaving 3s before the runner deadline. 0 disables extra model cost.
CONTROL_SHADOW=1
# Experimental spread-based price adjustment: evaluate before enabling.
PRICING_UNCERTAINTY=0
# Conditional-price learning from comparable November items and category errors:
# validated = apply only after chronological evidence; shadow = log proposals; off = disable.
PRICE_LEARNING=validated
# Recall caps from earlier games with the identical policy text (read each game, no restart):
# 2 = cap a AND b at 0.95 x the lowest recalled unfair level (default), 1 = cap a at the middle
# of a two-sided recalled t range, loose = also just below a one-sided unfair level, shadow = log only, 0 = off.
RECALL_CAP=2
# Public leaderboard learning between rounds. Starts only in the scheduled, non-dry runner.
# No model calls; defaults below apply even when absent from an existing .env.
LEARNING_AUTO=1
TEAM_NAME=chineseModels
# Optional absolute learning artifact path; default is out/learning.json beside runner.py.
# LEARNING_FILE=/absolute/path/to/out/learning.json
